---
export interface Props {
  title?: string
  description?: string
}

const {
  title = 'Mahesh Cheemalapati — Software Engineer',
  description = 'Portfolio of Mahesh Cheemalapati, software engineer specializing in frontend, cloud, and AI.',
} = Astro.props
---

<!doctype html>
<html lang="en" class="home">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/themes.css';

  @font-face {
    font-family: 'Zen Antique Soft';
    src: url('/fonts/ZenAntiqueSoft-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Shippori Mincho';
    src: url('/fonts/ShipporiMincho-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Shippori Mincho';
    src: url('/fonts/ShipporiMincho-Bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
  }

  @font-face {
    font-family: 'Exo 2';
    src: url('/fonts/Exo2-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Exo 2';
    src: url('/fonts/Exo2-Medium.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
  }

  @font-face {
    font-family: 'Exo 2';
    src: url('/fonts/Exo2-Bold.woff2') format('woff2');
    font-weight: 700;
    font-display: swap;
  }

  @font-face {
    font-family: 'Bebas Neue';
    src: url('/fonts/BebasNeue-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
</style>
